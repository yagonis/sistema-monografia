# Copie para .env e substitua os valores antes de iniciar o Compose.
DB_PASSWORD=SUBSTITUA_POR_UM_SEGREDO_HEXADECIMAL
BROKER_PASSWORD=SUBSTITUA_POR_OUTRO_SEGREDO_HEXADECIMAL
BUSCA_PASSWORD=SUBSTITUA_POR_OUTRO_SEGREDO_HEXADECIMAL
DJANGO_SECRET_KEY=SUBSTITUA_POR_UM_SEGREDO_LONGO
REPOSITORIO_INTEGRATION_KEY=SUBSTITUA_POR_OUTRO_SEGREDO_LONGO
# CIDRs reais da rede institucional/VPN; nunca confiar automaticamente em X-Forwarded-For.
ADMIN_NETWORKS=127.0.0.1/32,::1/128

# Configure o provedor SMTP para entregar notificações.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1
DEFAULT_FROM_EMAIL=webmaster@localhost
